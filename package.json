{
  "name": "open-carrusel",
  "version": "0.1.0",
  "description": "AI-powered Instagram carousel builder. Design slides with Claude CLI or local Ollama; export as PNGs at exact Instagram dimensions.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hainrixz/open-carrusel"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:chat-timeouts": "node scripts/test-chat-timeouts.mjs",
    "test:slide-generation": "node --test src/lib/slide-generation.test.ts",
    "doctor": "node scripts/doctor.mjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dev:electron": "npm run build:electron && env -u ELECTRON_RUN_AS_NODE electron .",
    "start:electron": "npm run build:electron && env -u ELECTRON_RUN_AS_NODE electron .",
    "build:desktop": "node scripts/install-browser.mjs && next build && node scripts/prepare-standalone.mjs && npm run build:electron && electron-builder --linux AppImage",
    "build:desktop:linux": "node scripts/install-browser.mjs --platform=linux && next build && node scripts/prepare-standalone.mjs && npm run build:electron && electron-builder --linux AppImage",
    "build:desktop:win": "node scripts/install-browser.mjs --platform=win64 && next build && node scripts/prepare-standalone.mjs && npm run build:electron && electron-builder --win nsis"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "archiver": "^7.0.1",
    "async-mutex": "^0.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-spawn": "^7.0.6",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "puppeteer": "^24.40.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^7.0.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "author": "Enrique Rocha (@soyenriquerocha) (https://www.tododeia.com)",
  "allowScripts": {
    "puppeteer@24.40.0": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true
  },
  "build": {
    "appId": "com.opencarrusel.app",
    "productName": "Open Carrusel",
    "directories": {
      "output": "release"
    },
    "afterPack": "./scripts/after-pack.mjs",
    "files": [
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*",
          "!release/**",
          "!bundled-chromium/**",
          "!data/**",
          "!docs/**",
          "!src/**"
        ]
      },
      {
        "from": "bundled-chromium",
        "to": "chromium",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/app/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Open Carrusel",
      "uninstallDisplayName": "Open Carrusel",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName} Setup ${version}.${ext}"
    }
  },
  "optionalDependencies": {
    "@img/sharp-libvips-win32-x64": "^1.2.4",
    "@img/sharp-win32-x64": "^0.34.5"
  }
}
